# ── Server ──────────────────────────────────────────────
PORT=5000

# MongoDB connection string. If you leave this empty the API starts an
# embedded MongoDB and stores its files in server/.data/mongo.
# MONGODB_URI=mongodb://127.0.0.1:27017/taskly
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskly

# Comma-separated list of allowed browser origins (production only).
# CORS_ORIGIN=https://your-app.netlify.app

# Set to false to start with an empty task list instead of demo tasks.
SEED_DEMO=true

# ── Client ──────────────────────────────────────────────
# Leave empty in development: Vite proxies /api to http://localhost:5000.
# In production set this to your deployed API origin.
# VITE_API_URL=https://taskly-api.onrender.com
