# ── Server ──────────────────────────────────────────────
PORT=5000

# MongoDB connection string. 
MONGODB_URI=mongodb+srv://username:password@database.mongodb.net/Taskly

# Comma-separated list of allowed browser origins (production only).
# CORS_ORIGIN=https://task.ritik.biz

# Set to false to start with an empty task list instead of demo tasks.
SEED_DEMO=true

# ── Client ──────────────────────────────────────────────
# Deployed API origin.
# VITE_API_URL=https://taskly.vercel.app
